# ==============================================================================
# TRAFFIQ: AI-Powered Intelligent Traffic Management System
# Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Type Checking
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
nosetests.xml
coverage.xml

# ------------------------------------------------------------------------------
# 2. Node.js & Frontend (Vite, React, TypeScript)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
.npm
dist/
frontend/dist/
.vite/
frontend/.vite/
*.tsbuildinfo

# Node debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 3. AI / Machine Learning & Computer Vision Weights
# ------------------------------------------------------------------------------
# Deep learning weights (prevent committing multi-hundred MB model checkpoints)
*.pt
*.pth
*.onnx
*.engine
*.tflite
*.pkl
*.joblib
*.h5

# Ultralytics / YOLO artifacts
runs/
.ultralytics/

# ------------------------------------------------------------------------------
# 4. Database & Storage
# ------------------------------------------------------------------------------
# SQLite databases
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# ------------------------------------------------------------------------------
# 5. Media, Video Streams & Uploads
# ------------------------------------------------------------------------------
uploaded_videos/
datasets/*.mp4
datasets/*.avi
datasets/*.mov
datasets/*.mkv

# Whitelist standard sample synthetic test traffic video
!datasets/sample_traffic.mp4

# ------------------------------------------------------------------------------
# 6. Environment Configurations & Secrets
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# ------------------------------------------------------------------------------
# 7. Operating System & Editor Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Editors & IDEs
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Logs & Temporary files
*.log
*.tmp
*.bak

# ------------------------------------------------------------------------------
# 8. Agent & Workspace Artifacts
# ------------------------------------------------------------------------------
.gemini/
.antigravity/
